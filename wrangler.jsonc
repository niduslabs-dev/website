{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niduslabs-website",
  // The Nidus Labs Cloudflare account, which also holds the niduslabs.dev zone.
  "account_id": "16a3f923e905d6a0e1f7b289d1311519",
  "compatibility_date": "2026-10-08",
  // Only the live releases pages run the Worker (src/releases.js); every other
  // path is a static asset from public/, served without invoking it.
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/drop/releases", "/drop/releases/", "/pane/releases", "/pane/releases/"]
  },
  // The deployed version's id keys the rendered-page cache, so a deploy that
  // changes the markup renders each page afresh.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [{ "pattern": "niduslabs.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
